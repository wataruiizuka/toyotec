$connectionUrl = "https://cdp-toyotecdap-nifi-ve-je-management0.toyotecd.kj09-szpi.a0.cloudera.site/cdp-toyotecdap-nifi-ve-je/cdp-proxy-api/nifi-app/nifi-api/process-groups/161738d5-e892-1713-ae84-c17687bda86e/connections"

$connectionFile = Join-Path $env:TEMP "nifi-connections.json"

curl.exe `
  --proxy "socks5h://127.0.0.1:1080" `
  -u "wataru_iizuka_za" `
  -sS `
  -o "$connectionFile" `
  "$connectionUrl"

$connectionResult = Get-Content `
  -LiteralPath "$connectionFile" `
  -Raw `
  -Encoding UTF8 | ConvertFrom-Json

$connectionResult.connections | ForEach-Object {
    [PSCustomObject]@{
        Name         = $_.component.name
        Source       = $_.component.source.name
        SourceType   = $_.component.source.type
        Destination  = $_.component.destination.name
        DestType     = $_.component.destination.type
        Relationships= ($_.component.selectedRelationships -join ",")
        CanRead      = $_.permissions.canRead
        CanWrite     = $_.permissions.canWrite
        Id           = $_.id
    }
} | Format-Table -AutoSize

Remove-Item "$connectionFile" -ErrorAction SilentlyContinue
