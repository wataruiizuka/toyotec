$securePassword = Read-Host "Cloudera Workload Password" -AsSecureString
$bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($securePassword)
$plainPassword = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)

try {
    & "$HOME\Tools\NiFi\nifi-toolkit-1.28.1\bin\cli.bat" nifi pg-list `
    -pgid "f2613412-e31d-1ff9-0000-0000526547ae" `
    -u "https://cdp-toyotecdap-nifi-ve-je-management0.toyotecd.kj09-szpi.a0.cloudera.site/cdp-toyotecdap-nifi-ve-je/cdp-proxy-api/nifi-app/nifi-api/" `
    -bau "wataru_iizuka_za" `
    -bap $plainPassword `
    -ts "$env:JAVA_HOME\lib\security\cacerts" `
    -tst JKS `
    -tsp changeit `
    -ot json
}
finally {
    [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
    Remove-Variable plainPassword,securePassword,bstr -ErrorAction SilentlyContinue
}
