New-Item -ItemType Directory -Force "$HOME\Tools\NiFi" | Out-Null


Expand-Archive `
  -Path "$HOME\Downloads\nifi-toolkit-1.28.1-bin.zip" `
  -DestinationPath "$HOME\Tools\NiFi" `
  -Force


Get-ChildItem "$HOME\Tools\NiFi" |
  Select-Object Name,Mode,LastWriteTime


Get-ChildItem "$HOME\Tools\NiFi" -Recurse -File |
  Where-Object { $_.Name -match '^cli\.(bat|cmd|sh)$' } |
  Select-Object FullName
