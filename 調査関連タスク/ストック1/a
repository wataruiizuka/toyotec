$processorUrl = "https://cdp-toyotecdap-nifi-ve-je-management0.toyotecd.kj09-szpi.a0.cloudera.site/cdp-toyotecdap-nifi-ve-je/cdp-proxy-api/nifi-app/nifi-api/process-groups/161738d5-e892-1713-ae84-c17687bda86e/processors"

$processorResult = curl.exe `
  --proxy "socks5h://127.0.0.1:1080" `
  -u "wataru_iizuka_za" `
  -sS `
  $processorUrl | ConvertFrom-Json

$processorResult.processors | ForEach-Object {
    [PSCustomObject]@{
        Name        = $_.component.name
        Type        = $_.component.type
        State       = $_.component.state
        Validation  = $_.component.validationStatus
        CanRead     = $_.permissions.canRead
        CanWrite    = $_.permissions.canWrite
        OperateRead = $_.operatePermissions.canRead
        OperateWrite= $_.operatePermissions.canWrite
        Id          = $_.id
    }
} | Format-Table -AutoSize
